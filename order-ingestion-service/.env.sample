PORT=3000

# Base URL of the mock customer APIs the poller calls (separate process, :4000)
MOCKS_BASE_URL=http://localhost:4000

# SQLite database file. Use :memory: for an ephemeral store.
DB_PATH=./data/orders.sqlite

# Set to false to boot the service without starting the pollers.
POLLING_ENABLED=true

# Demo helper: overrides EVERY pull customer's interval (ms) so you can watch
# polling without waiting 5–15 min. Leave unset to use real per-customer rates.
# DEMO_POLL_INTERVAL_MS=15000

# Optional webhook HMAC-SHA256 secret. When unset, signature checks are off.
# WEBHOOK_SECRET=
